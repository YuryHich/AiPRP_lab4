# Скопируйте этот файл в .env (или запустите setup-app.cmd).
# producer - компьютер, который отправляет сообщения; consumer - компьютер, который их получает
ROLE=consumer
# Имя узла, видно в сообщениях: producer, consumer1, consumer2, consumer3
NODE_NAME=consumer1
# IP трёх брокеров
BROKER1_IP=192.168.43.11
BROKER2_IP=192.168.43.12
BROKER3_IP=192.168.43.13
# Одинаковое значение у нескольких консьюмеров = они делят сообщения между собой (эксперимент)
KAFKA_GROUP=
