# Скопируйте этот файл в .env (или запустите setup-broker.cmd) и подставьте свои адреса.
# NODE_ID: 1, 2 или 3, у каждого брокера свой
NODE_ID=1
# IP ЭТОГО компьютера в общей сети (узнать: scripts\my-ip.cmd)
MY_IP=192.168.43.11
# IP всех трёх брокеров, одинаковые у всех семи компьютеров
BROKER1_IP=192.168.43.11
BROKER2_IP=192.168.43.12
BROKER3_IP=192.168.43.13
